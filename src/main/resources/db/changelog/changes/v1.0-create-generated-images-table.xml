<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="4" author="trendai">
        <comment>Create generated_images table</comment>
        
        <createTable tableName="generated_images">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="trend_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="input_images" type="JSON"/>
            <column name="output_image_path" type="VARCHAR(255)"/>
            <column name="prompt_used" type="TEXT"/>
            <column name="ai_parameters" type="JSON"/>
            <column name="generation_time_seconds" type="DECIMAL(5,2)"/>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_generated_images_user_id"
                baseTableName="generated_images"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                constraintName="fk_generated_images_trend_id"
                baseTableName="generated_images"
                baseColumnNames="trend_id"
                referencedTableName="trends"
                referencedColumnNames="id"/>

        <createIndex indexName="idx_user_id" tableName="generated_images">
            <column name="user_id"/>
        </createIndex>
        
        <createIndex indexName="idx_gen_status" tableName="generated_images">
            <column name="status"/>
        </createIndex>

        <rollback>
            <dropTable tableName="generated_images"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

