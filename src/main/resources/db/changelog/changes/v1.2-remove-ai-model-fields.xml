<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="v1.2-remove-ai-model-fields" author="system">
        <comment>Remove AI model fields since we only use Gemini now</comment>
        
        <!-- Drop ai_model and ai_parameters from trends table -->
        <dropColumn tableName="trends" columnName="ai_model"/>
        <dropColumn tableName="trends" columnName="ai_parameters"/>
        
        <rollback>
            <addColumn tableName="trends">
                <column name="ai_model" type="VARCHAR(50)">
                    <constraints nullable="true"/>
                </column>
            </addColumn>
            <addColumn tableName="trends">
                <column name="ai_parameters" type="JSON">
                    <constraints nullable="true"/>
                </column>
            </addColumn>
        </rollback>
    </changeSet>

</databaseChangeLog>

